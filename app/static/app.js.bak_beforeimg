function pickRefundItem(){
  const i=document.getElementById('refund-picker').value;
  if(i==='')return;
  const x=REFUNDABLE_ITEMS[+i]; if(!x)return;
  document.getElementById('refund-order').value=x.orderId;
  document.getElementById('refund-item').value=x.itemId;
  document.getElementById('refund-amount').value=Number(x.remainingAmount).toFixed(2);
