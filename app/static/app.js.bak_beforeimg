    box.innerHTML=`<b style="color:var(--text)">${d.chunks||0} 个知识切片</b> · ${(d.cities||[]).length} 个城市 &nbsp; ${types}`;
  }catch(e){box.textContent='知识库状态加载失败';}
}
async function doKbSearch(){
  const q=document.getElementById('kb-q').value.trim();
  const city=document.getElementById('kb-city').value;
  const type=document.getElementById('kb-type').value;
  const box=document.getElementById('kb-result');
  box.innerHTML='<div class="card"><div class="loading"><span class="spin"></span>检索中…</div></div>';
  try{
    const params={q,city,type,topK:8};
    const r=await api('/api/meta/kb/search',{params});
    const items=(r.data&&r.data.items)||[];
    if(!items.length){box.innerHTML='<div class="card"><div class="empty">没有匹配的攻略片段，换个关键词试试。</div></div>';return}
    window.__lastKbItems=items;
    box.innerHTML=`<div class="card"><h2>检索结果 <span class="api-tag">${r.data.total} 条</span></h2>`+
      items.map((it,idx)=>`<div class="item" style="display:block"><div class="main">
        <h4>${esc(it.title)} <span class="tag">${esc(it.contentType)}</span> <span class="tag">${esc(it.city)}</span></h4>
        <div class="sub" style="white-space:pre-wrap;margin:6px 0">${esc(it.text)}</div>
        <div class="sub" style="color:#16a34a">出处：${esc(it.source)}</div>
        <div class="actions" style="margin-top:8px">
          <button class="btn sm ghost" onclick="askAIAbout(${idx})">让 AI 讲讲这段攻略 →</button>
          <button class="btn sm ghost" onclick="searchCityProducts('${esc(it.city||'')}')">搜该城市商品 →</button>
        </div>
      </div></div>`).join('')+'</div>';
  }catch(e){box.innerHTML=`<div class="card"><div class="empty">检索出错：${esc(e.message||e)}</div></div>`;}
}
function showKbForCity(city){
  const c=String(city||'').replace(/[市省]$/,'');
