/* ---- 原生 select → 自定义下拉 ----
   webview 里原生 <select> 的弹层会脱离元素画到页面左上角（就是"下拉条飞了"），
   所以把所有 select 包成页内渲染的 combo。原 select 保留在 DOM 里（display:none），
   选中时回写 .value 并派发 change，业务代码读 .value / onchange 全部照旧。 */
function selectGroups(sel){
  const groups=[];
  Array.from(sel.children).forEach(node=>{
    if(node.tagName==='OPTGROUP'){
      groups.push({label:node.label||'', items:Array.from(node.children).map(o=>({v:o.value,t:(o.textContent||'').trim(),dis:o.disabled}))});
    }else if(node.tagName==='OPTION'){
      if(!groups.length) groups.push({label:'',items:[]});
      groups[groups.length-1].items.push({v:node.value,t:(node.textContent||'').trim(),dis:node.disabled});
    }
  });
  return groups;
}
function upgradeSelect(sel){
  if(!sel || sel.dataset.upgraded==='1' || sel.closest('.combo')) return;
  sel.dataset.upgraded='1';
  const needSearch = sel.options.length>8;
  const wrap=document.createElement('div');
  wrap.className='combo';
  wrap.dataset.selectCombo='1';
  wrap.innerHTML='<div class="combo-toggle" tabindex="0"></div>'+
    '<div class="combo-panel">'+(needSearch?'<input class="combo-search" type="text" placeholder="搜索…" autocomplete="off">':'')+
    '<div class="combo-list"></div></div>';
  sel.parentNode.insertBefore(wrap,sel);
  wrap.appendChild(sel);
  sel.style.display='none';
  const toggle=wrap.querySelector('.combo-toggle');
  const search=wrap.querySelector('.combo-search');
  const list=wrap.querySelector('.combo-list');
  const syncToggle=()=>{const o=sel.options[sel.selectedIndex];toggle.textContent=o?(o.textContent||'').trim():'';};
  const render=()=>{
    const kw=(search?search.value:'').trim();
    let html='';
    selectGroups(sel).forEach(g=>{
      const items=g.items.filter(it=>!kw||it.t.includes(kw)||String(it.v).includes(kw));
      if(!items.length) return;
      if(g.label) html+='<div class="combo-group">'+esc(g.label)+'</div>';
      html+=items.map(it=>'<div class="combo-item'+(it.v===sel.value?' sel':'')+(it.dis?' dis':'')+'" data-val="'+esc(it.v)+'">'+esc(it.t)+'</div>').join('');
    });
    list.innerHTML=html||'<div class="combo-empty">无匹配选项</div>';
  };
  toggle.onclick=e=>{
    e.stopPropagation();
    const willOpen=!wrap.classList.contains('open');
    comboCloseAll(wrap);
    if(willOpen){render();wrap.classList.add('open');if(search){search.value='';setTimeout(()=>search.focus(),0);}}
    else wrap.classList.remove('open');
  };
  if(search) search.oninput=render;
  list.onclick=e=>{
    const item=e.target.closest('.combo-item');
    if(!item||item.classList.contains('dis')) return;
    e.stopPropagation();
    sel.value=item.dataset.val;
    syncToggle();
    wrap.classList.remove('open');
    sel.dispatchEvent(new Event('change',{bubbles:true}));
  };
  syncToggle();
  sel._syncCombo=syncToggle;   // 供程序化改值时手动同步显示
  // 浏览器刷新会恢复表单状态，稍后再同步一次显示文字
  window.addEventListener('pageshow',syncToggle);
}
function upgradeAllSelects(){ document.querySelectorAll('select').forEach(upgradeSelect); }
function syncComboOf(id){const s=document.getElementById(id);if(s&&s._syncCombo)s._syncCombo();}

async function api(path, {method='GET', params={}, body, headers={}}={}){
  let url = API + path;
  const q = new URLSearchParams(Object.entries(params).filter(([,v])=>v!=='' && v!=null));
  if (q.toString()) url += '?' + q;
  const opt = {method, headers:{'Content-Type':'application/json',...headers}};
  if (body) opt.body = JSON.stringify(body);
  const resp = await fetch(url, opt);
  let data; try{ data = await resp.json(); }catch{ data = {raw:await resp.text()}; }
  return {ok:resp.ok, status:resp.status, data};
}

