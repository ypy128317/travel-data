    respBox.innerHTML=`<div class="result-head"><h3>响应</h3><span class="badge err">失败</span></div><div class="resp">请先点"加载可退明细"并选择一条明细，不要手动留空。</div>`;
    return;
  }
  if(!(amount>0)){
    respBox.innerHTML=`<div class="result-head"><h3>响应</h3><span class="badge err">失败</span></div><div class="resp">退款金额必须大于 0。</div>`;
