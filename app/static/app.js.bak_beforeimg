  const headers={'X-User-Id':document.getElementById('ep-uid').value};
  if(path.includes('payments/callback'))headers['X-Demo-Payment-Signature']='mock-payment-signature';
  const qParams={};
  ['pageNo','pageSize'].forEach(k=>{const el=document.getElementById('ep-q-'+k);if(el)qParams[k]=el.value;});
  let body; const ta=document.getElementById('ep-json'); if(ta){try{body=JSON.parse(ta.value);}catch{document.getElementById('ep-resp').innerHTML='<div class="resp">JSON 格式错误</div>';return;}}
  const box=document.getElementById('ep-resp');box.innerHTML='<div class="loading"><span class="spin"></span>请求中...</div>';
  const r=await api(path,{method:e[1],params:qParams,body,headers});
  box.innerHTML=`<div class="result-head"><h3>响应 · ${r.status}</h3><span class="badge ${r.ok?'ok':'err'}">${r.ok?'成功':'失败'}</span></div><div class="resp">${esc(JSON.stringify(r.data,null,2))}</div>`;
}

