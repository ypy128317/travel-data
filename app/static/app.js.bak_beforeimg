function openMapWith(city,spots){
  // 地图已内嵌为同源 iframe（/map，Key 由后端注入），直接把线路通过 hash 送进去绘制。
  // 重设 src 会重载 iframe 回到「自由绘制」，因此清掉待推送的 AI 行程，避免又被推回去。
  pendingPlan=null;
  const params='city='+encodeURIComponent(city||'')+'&spots='+encodeURIComponent(spots||'');
  const frame=document.getElementById('map-frame');
  if(frame){switchPanel('map');frame.src='/map#'+params;}
  else window.open('/map#'+params,'_blank');
}
function sendPlanToMap(spots,city){
  const c=(['三亚','云南','厦门','张家界','成都','杭州'].includes(city))?city:'三亚';
  openMapWith(c,(spots||[]).join(','));
}
/* ===== AI 行程 × 地图：把完整行程对象推送进 iframe ===== */
let pendingPlan=null;
function pushPlanToFrame(){
  const f=document.getElementById('map-frame');
  if(f&&f.contentWindow&&pendingPlan){
    f.contentWindow.postMessage({type:'ai-plan',plan:pendingPlan},'*');
  }
}
function openPlanOnMap(){
  const d=window.__lastPlan;
  if(!d||!d.days_plan){alert('请先生成一份 AI 行程');return;}
  pendingPlan=Object.assign({},d,{_uid:Date.now()+'_'+Math.random().toString(36).slice(2,7)});
  switchPanel('map');
  // iframe 可能尚未 ready，延迟多发几次（地图页对同一 _uid 幂等）
  [180,600,1200].forEach(t=>setTimeout(pushPlanToFrame,t));
}
// 地图页 load 完成会回报 map-ready；同时响应「回 AI 行程助手」
window.addEventListener('message',e=>{
  const d=e.data||{};
  if(d.type==='map-ready'&&pendingPlan)pushPlanToFrame();
