/* 知识库片段 → AI 问答：把出处内容直接写进问题并自动提问 */
function askAIAbout(i){
  const it=(window.__lastKbItems||[])[i];if(!it)return;
  const clean=String(it.city||'').replace(/[市省]$/,'');
  if(clean)setCityContext(clean,KB_AREA[clean]);
  document.getElementById('ai-question').value='请根据这段攻略，给我一个可落地的行程建议：'+String(it.title||'')+'。'+String(it.text||'').slice(0,180);
  switchPanel('ai');
  aiChat();
  toast('已把攻略「'+String(it.title||'').slice(0,14)+'」交给 AI');
}
