/* 把城市同步到 AI / 知识库 / 商品搜索三处，保持全站上下文一致 */
function setCityContext(name,id){
  if(!name)return;
  const clean=String(name).replace(/[市省]$/,'');
  const aid=+(id||KB_AREA[clean]||0)||null;
  setCtx({city:clean,cityId:aid});
  const ai=document.getElementById('ai-city');
  if(ai){
    let v=KB_AREA[clean]?'kb|'+clean:null;
    if(!v){const hit=CITIES.find(c=>+c[0]===+aid||c[1]===clean||c[1]===clean+'市');if(hit)v=hit[0]+'|'+clean;}
    if(v){ai.value=v;syncComboOf('ai-city');}
  }
  const kb=document.getElementById('kb-city');
  if(kb&&['三亚','云南','厦门','张家界','成都','杭州'].includes(clean)){kb.value=clean;syncComboOf('kb-city');}
  if(aid){
    const cfg=TYPES[currentType]||{};
    const f=(cfg.fields||[]).find(x=>x.k==='areaId')||(cfg.fields||[]).find(x=>x.k==='arrivalAreaId')||(cfg.fields||[]).find(x=>x.k==='departureAreaId');
    if(f){
      const inp=document.getElementById('f_'+f.k);
      if(inp){
        inp.value=aid;
        const combo=inp.closest('.combo');
        if(combo){combo.dataset.sel=aid;const t=combo.querySelector('.combo-toggle');if(t)t.textContent=CITYNAME(aid)||clean;}
      }
    }
  }
}
function applyPlanContext(d){
  window.__lastPlan=d;
  const clean=String(d.city||'').replace(/[市省]$/,'');
  setCityContext(clean,d.areaId||KB_AREA[clean]);
  setCtx({plan:d,product:null,orderId:null,paymentNo:null,paid:false,refundId:null});
}
function syncPlanEverywhere(){
  const d=window.__lastPlan;if(!d){toast('请先生成一份行程');return;}
  applyPlanContext(d);
  toast('已同步：城市「'+CTX.city+'」带入搜索、知识库与地图');
