let currentType='flight';
function buildFields(){
  const cfg=TYPES[currentType];
  document.getElementById('api-path').textContent=cfg.api;
  document.getElementById('fields').innerHTML=cfg.fields.map(f=>{
    let input;
    if(f.type==='city') input=cityCombo('f_'+f.k, f.sel||2);
    else if(f.type==='date') input=`<input id="f_${f.k}" type="date" value="${f.val()}">`;
    else input=`<input id="f_${f.k}" type="text" value="${f.val?f.val():''}">`;
    return `<div class="field"><label>${f.label}</label>${input}</div>`;
  }).join('');
}
async function doSearch(){
  const cfg=TYPES[currentType], params={};
  cfg.fields.forEach(f=>params[f.k]=document.getElementById('f_'+f.k).value);
  params.pageNo=1; params.pageSize=20;
  const box=document.getElementById('result');
  box.innerHTML='<div class="loading"><span class="spin"></span>查询中...</div>';
  document.getElementById('detail').innerHTML='';
  const {ok,data}=await api(cfg.api,{params});
  if(!ok){box.innerHTML=`<div class="empty">查询失败：${esc(JSON.stringify(data.detail||data))}</div>`;return}
  const list=data.list||[];
  document.getElementById('result-count').textContent=`共 ${data.total||0} 条`;
  if(!list.length){box.innerHTML='<div class="empty">没有找到匹配的数据，换个条件试试</div>';return}
  window._lastParams=params;
  box.innerHTML=list.map((x,i)=>{
    const r=cfg.render(x);
    const price=r.price!=null?`<div class="price">¥${Number(r.price).toFixed(0)}<small> ${r.cur||''}</small></div>`:`<div class="sub">${r.extra||''}</div>`;
    return `<div class="item"><div class="main" onclick="showDetail(${i})" style="cursor:pointer"><h4>${esc(r.title)}</h4><div class="sub">${esc(r.sub||'')}</div><div class="tags">${(r.tags||[]).filter(Boolean).map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div></div><div class="side">${price}<button class="btn sm" style="margin-top:6px" onclick="buyThis(${i})">去下单 →</button><div class="sub" style="margin-top:3px;font-size:11px;cursor:pointer" onclick="showDetail(${i})">看详情</div></div></div>`;
  }).join('');
  window._lastList=list;
}

/* 从搜索卡片一键下单：解析参数 → 调 suggest → 填入交易演示 */
async function buyThis(i){
  const x=window._lastList[i], cfg=TYPES[currentType], p=window._lastParams||{};
  const dateKey={hotel:'checkInDate',scenic:'travelDate',flight:'departureDate',train:'departureDate',bus:'departureDate',transfer:'businessDate'}[currentType];
  const payload={
    type:cfg.suggestType,
    refId:x.refId!=null?x.refId:x.departureId||x.hotelId||x.scenicSpotId||x.serviceId,
    date:p[dateKey]||daysFromNow(6),
    returnDate:p.checkOutDate||null,
    userId:+currentUid(),
  };
  const box=document.getElementById('result');
  const r=await api('/api/meta/order-suggest',{method:'POST',body:payload});
  if(!r.ok||!r.data.ok){
    box.insertAdjacentHTML('beforeend',`<div class="note" style="margin-top:10px;color:#c0392b">无法下单：${esc(r.data.message||JSON.stringify(r.data.detail||r.data))}</div>`);
    return;
  }
  // 填入交易演示第1步，并写入全局会话
  const picked=r.data.item||{};
  setCtx({product:{name:picked.productName||x.hotelName||x.scenicName||'所选商品',
                   refId:picked.productId||x.refId,type:cfg.suggestType,price:picked.salePrice||r.price||null},
          orderId:null,paymentNo:null,paid:false,refundId:null});
  trade={step:1,orderId:null,items:[],paymentNo:null,amount:null,preset:r.data};
  setFlow('trade');
  switchPanel('trade');
  renderTrade();
  document.getElementById('t-resp').innerHTML=`<div class="note" style="color:#1a7f37">已从商品搜索带入：<b>${esc(picked.productName||'所选商品')}</b>。下单 → 支付 → 退款的后续数据会自动同步到全站状态条。</div>`;
  toast('已带入商品：'+(picked.productName||'所选商品'));
}
/* 复用全站状态里的上一个商品，不必回搜索页重新挑 */
function reuseCtxProduct(){
  const p=CTX.product;if(!p)return;
  const typeMap={hotel:'hotel_room',scenic:'scenic_ticket',transfer:'transfer_service'};
  const ptype=typeMap[p.type]||p.type||'hotel_room';
  const item={productTypeCode:ptype,productId:+p.refId||1,productName:p.name||'所选商品',quantity:1};
  if(ptype==='hotel_room'){item.checkInDate=daysFromNow(6);item.checkOutDate=daysFromNow(8);}
  else item.travelTime=daysFromNow(6)+' 09:00:00';
  trade={step:1,orderId:null,items:[],paymentNo:null,amount:null,
    preset:{ok:true,orderTypeCode:ptype,item,needsTraveler:false}};
  renderTrade();
  toast('已复用商品：'+p.name);
}
