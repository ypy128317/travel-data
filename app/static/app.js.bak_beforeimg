const API = '';
// 全量城市从后端接口加载（数据库 level=2 共 375 个），默认保留几个避免首屏空白
let CITIES = [[2,'北京市'],[786,'上海市'],[2278,'成都市'],[1945,'深圳市']];
let CITY_EXTRA = {};  // id -> fullName
async function loadCities(){
  try{
    const r = await api('/api/meta/cities');
    if(r.ok && r.data.cities && r.data.cities.length){
      CITIES = r.data.cities.map(c=>[c.id, c.name]);
      CITY_EXTRA = Object.fromEntries(r.data.cities.map(c=>[c.id, c.fullName||'']));
      // 已渲染的下拉组件刷新选项
      document.querySelectorAll('.combo[data-city]').forEach(comboRenderList);
    }
  }catch(e){ console.warn('城市列表加载失败，使用默认', e); }
}
const uid = () => currentUid();   // 全站统一用户 ID，不再各面板各读一份
const fmtDate = d => d.toISOString().slice(0,10);
const daysFromNow = n => { const d=new Date(); d.setDate(d.getDate()+n); return fmtDate(d); };
const CITYNAME = id => (CITIES.find(c=>c[0]==id)||[,'#'+id])[1];

/* ---- 自定义城市下拉组件（原生 select 在 webview 中弹层会错位） ---- */
function cityCombo(inputId, sel){
  const selId = Number(sel||2);
  const name = CITYNAME(selId);
  return `<div class="combo" data-city data-input="${inputId}" data-sel="${selId}">
    <div class="combo-toggle" tabindex="0">${esc(name)}</div>
    <div class="combo-panel">
      <input class="combo-search" type="text" placeholder="搜索城市…" autocomplete="off">
      <div class="combo-list"></div>
    </div>
    <input type="hidden" id="${inputId}" value="${selId}">
  </div>`;
}
function comboRenderList(combo){
  const kw=(combo.querySelector('.combo-search')?.value||'').trim();
  const sel=Number(combo.dataset.sel);
  const list=combo.querySelector('.combo-list'); if(!list)return;
  const matched=CITIES.filter(([id,n])=>!kw||n.includes(kw)||String(id).includes(kw));
  if(!matched.length){ list.innerHTML='<div class="combo-empty">未找到匹配城市</div>'; return; }
  list.innerHTML=matched.slice(0,300).map(([id,n])=>
    `<div class="combo-item ${id==sel?'sel':''}" data-id="${id}"><span>${esc(n)}</span>${CITY_EXTRA[id]?`<small>${esc(CITY_EXTRA[id])}</small>`:''}</div>`
  ).join('');
}
function comboCloseAll(except){
  document.querySelectorAll('.combo.open').forEach(c=>{ if(c!==except)c.classList.remove('open'); });
}
function comboInit(){
  document.addEventListener('click', e=>{
    const toggle=e.target.closest('.combo-toggle');
    if(toggle){
      if(toggle.closest('[data-select-combo]')) return;   // 原生 select 升级成的 combo 自带逻辑
      const combo=toggle.closest('.combo'); const willOpen=!combo.classList.contains('open');
      comboCloseAll(combo);
      if(willOpen){ comboRenderList(combo); combo.classList.add('open'); const s=combo.querySelector('.combo-search'); if(s){s.value='';setTimeout(()=>s.focus(),0);} }
      else combo.classList.remove('open');
      return;
    }
    const item=e.target.closest('.combo-item');
    if(item){
      const combo=item.closest('.combo');
      if(combo.dataset.selectCombo) return;               // 同上，避免两套逻辑打架
      const id=item.dataset.id;
      combo.dataset.sel=id;
      combo.querySelector('input[type=hidden]').value=id;
      combo.querySelector('.combo-toggle').textContent=CITYNAME(Number(id));
      combo.classList.remove('open');
      combo.dispatchEvent(new CustomEvent('citychange',{bubbles:true,detail:{id:Number(id),inputId:combo.dataset.input}}));
      return;
    }
    if(!e.target.closest('.combo')) comboCloseAll();
  });
  document.addEventListener('input', e=>{
    if(!e.target.classList.contains('combo-search')) return;
    const combo=e.target.closest('.combo');
    if(combo && combo.dataset.selectCombo) return;         // 城市 combo 的搜索才走 CITIES 过滤
    if(combo) comboRenderList(combo);
  });
}
const esc = s => String(s??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));

