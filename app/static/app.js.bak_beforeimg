let REFUNDABLE_ITEMS=[];
async function loadRefundableItems(){
  const u=currentUid();
  const sel=document.getElementById('refund-picker');
  sel.innerHTML='<option value="">加载中…</option>';
  syncComboOf('refund-picker');
  const r=await api('/api/meta/refundable-items',{params:{userId:u}});
  REFUNDABLE_ITEMS=(r.ok&&r.data.items)||[];
  if(!REFUNDABLE_ITEMS.length){
    sel.innerHTML='<option value="">该用户暂无可退明细</option>';
    syncComboOf('refund-picker');
    return;
  }
  sel.innerHTML='<option value="">— 请选择一条可退明细 —</option>'+REFUNDABLE_ITEMS.map((x,i)=>
    `<option value="${i}">订单#${x.orderId} · 明细#${x.itemId} · ${esc(x.productName)} · 可退 ¥${Number(x.remainingAmount).toFixed(2)}</option>`
  ).join('');
