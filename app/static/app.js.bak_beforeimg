  box.innerHTML=Object.entries(MAP_SPOTS).map(([c,arr])=>
    `<span class="tag" style="cursor:pointer;${CTX.city===c?'border-color:#4f46e5;background:#eef0ff;color:#4f46e5':''}" onclick="openMapCity('${c}')">${c} (${arr.length})</span>`
