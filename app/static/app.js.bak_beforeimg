const TYPE_LABEL={hotel_room:'酒店',scenic_ticket:'景点',flight_cabin:'机票',train_seat:'火车',bus_seat:'汽车',transfer_service:'接送'};
function renderTrade(){
  document.querySelectorAll('#steps .step').forEach(s=>{
    const n=+s.dataset.s;
    s.classList.toggle('active',n===trade.step);
    s.classList.toggle('done',n<trade.step);
  });
  const b=document.getElementById('trade-body');
  const hdr=(title,api)=>`<div class="card"><h2>${title} <span class="api-tag">${api}</span></h2>`;
  if(trade.step===1){
    const opts=Object.entries(TYPE_LABEL).map(([k,v])=>`<option value="${k}">${v}</option>`).join('');
    const pre=trade.preset;
    const it=pre?pre.item:null;
    const ptype=it?it.productTypeCode:'hotel_room';
    const pid=it?it.productId:1, pname=it?it.productName:'演示商品';
    const d1=it?(it.checkInDate||(it.travelTime||'').slice(0,10)):daysFromNow(6);
    const d2=it?(it.checkOutDate||daysFromNow(8)):daysFromNow(8);
    const reuse=(!pre&&CTX.product)?`<div class="actions" style="margin-top:0"><button class="btn sm ghost" id="t-reuse">↺ 用上次选的商品：${esc(String(CTX.product.name||'').slice(0,22))}</button></div>`:'';
    b.innerHTML=hdr('第 1 步 · 创建订单','POST /api/v1/orders')+
      `<div class="note">${pre?'已从'+(CTX.plan?'AI 行程':'商品搜索')+'带入参数，确认后直接下单。':'可到"商品搜索"选商品点"去下单"，或点 AI 行程里的商品标签自动带入，也可以手动填写。'}</div>${reuse}
       <div class="fields">
        <div class="field"><label>订单类型</label><select id="t-type">${Object.entries(TYPE_LABEL).map(([k,v])=>`<option value="${k}" ${k===ptype?'selected':''}>${v}</option>`).join('')}</select></div>
        <div class="field"><label>商品 ID（productId）</label><input id="t-pid" value="${pid}" type="number"></div>
        <div class="field"><label>商品名称</label><input id="t-pname" value="${esc(pname)}"></div>
        <div class="field"><label>入住/出行日期</label><input id="t-date" type="date" value="${d1}"></div>
        <div class="field"><label>离店日期（酒店）</label><input id="t-date2" type="date" value="${d2}"></div>
        <div class="field"><label>用户 ID</label><input id="t-uid" value="${currentUid()}" type="number"></div>
       </div>
       <div class="actions"><button class="btn" id="t-submit">创建订单</button></div><div id="t-resp"></div></div>`;
    document.getElementById('t-submit').onclick=createOrder;
    if(!pre&&CTX.product)document.getElementById('t-reuse').onclick=reuseCtxProduct;
  } else if(trade.step===2){
    b.innerHTML=hdr('第 2 步 · 发起支付',`POST /api/v1/orders/${trade.orderId}/pay`)+
      `<div class="note">订单 <b>#${trade.orderId}</b> 已创建，应付 <b>¥${trade.amount}</b>。发起支付后得到一个支付单。</div>
       <div class="fields">
        <div class="field"><label>支付方式</label><select id="t-paymethod"><option value="alipay">支付宝</option><option value="wechat">微信支付</option><option value="unionpay">银联</option></select></div>
        <div class="field"><label>客户端类型</label><select id="t-client"><option value="app">App</option><option value="web">Web</option><option value="miniapp">小程序</option></select></div>
       </div>
       <div class="actions"><button class="btn" id="t-submit">发起支付</button></div><div id="t-resp"></div></div>`;
    document.getElementById('t-submit').onclick=startPay;
  } else if(trade.step===3){
    b.innerHTML=hdr('第 3 步 · 支付回调','POST /api/v1/payments/callback')+
      `<div class="note">支付单 <b>${trade.paymentNo}</b>。回调需带签名头 <code>X-Demo-Payment-Signature: mock-payment-signature</code>，页面已自动带上。</div>
       <div class="fields">
        <div class="field"><label>回传状态</label><select id="t-cbstatus"><option value="success">支付成功</option><option value="failed">支付失败</option></select></div>
        <div class="field"><label>支付方式</label><select id="t-cbmethod"><option value="alipay">支付宝</option><option value="wechat">微信支付</option><option value="unionpay">银联</option></select></div>
       </div>
       <div class="actions"><button class="btn" id="t-submit">发送回调</button></div><div id="t-resp"></div></div>`;
    document.getElementById('t-submit').onclick=payCallback;
  } else {
    b.innerHTML=hdr('第 4 步 · 查看订单详情',`GET /api/v1/orders/${trade.orderId}`)+
      `<div class="note">交易完成。订单、支付单与金额已进入全站状态条，可以直接跳转到会员积分、售后退款或接口控制台继续演示，无需重新填参数。</div>
       <div class="actions">
         <button class="btn" id="t-submit">查询订单详情</button>
         <button class="btn" id="t-goto-refund" style="background:var(--price)">带此订单去退款 →</button>
         <button class="btn ghost" id="t-goto-member">看积分变化 →</button>
         <button class="btn ghost" id="t-goto-console">在控制台调试 →</button>
         <button class="btn gray" id="t-again">重新开始演示</button>
       </div>
       <div id="t-resp"></div></div>`;
    document.getElementById('t-submit').onclick=getOrder;
    document.getElementById('t-goto-refund').onclick=gotoRefundWithOrder;
    document.getElementById('t-goto-member').onclick=()=>{setFlow('pay');switchPanel('member');loadMember();loadPoints();toast('已带入用户 #'+currentUid()+'，积分流水已刷新');};
    document.getElementById('t-goto-console').onclick=()=>openConsoleFor('/api/v1/orders/{orderId}');
    document.getElementById('t-again').onclick=()=>{trade={step:1,orderId:null,items:[],paymentNo:null,amount:null,preset:null};setCtx({orderId:null,paymentNo:null,paid:false,refundId:null});renderTrade();};
  }
}
function tradeResp(box,{ok,data}){
  box.innerHTML=`<div class="result-head"><h3>响应</h3><span class="badge ${ok?'ok':'err'}">${ok?'成功':'失败'}</span></div><div class="resp">${esc(JSON.stringify(data,null,2))}</div>`;
}
async function createOrder(){
  const type=document.getElementById('t-type').value;
  const pid=+document.getElementById('t-pid').value;
  const pname=document.getElementById('t-pname').value;
  const d1=document.getElementById('t-date').value, d2=document.getElementById('t-date2').value;
  const u=document.getElementById('t-uid').value;
  let item;
  if(trade.preset && trade.preset.item && +document.getElementById('t-pid').value===trade.preset.item.productId){
    // 用 suggest 返回的完整参数（保留 travelTime / travelerIds）
    item={...trade.preset.item};
    item.productName=pname;
  } else {
    item={productTypeCode:type,productId:pid,productName:pname,quantity:1};
    if(type==='hotel_room'){item.checkInDate=d1;item.checkOutDate=d2;}
    else {
      item.travelTime=d1+' 10:00:00';
      if(REQUIRES_TRAVELER.has(type)){
        const tr=await api('/api/v1/me/travelers',{params:{pageNo:1,pageSize:1},headers:{'X-User-Id':u}});
        const tid=tr.data?.list?.[0]?.travelerId;
        if(tid)item.travelerIds=[tid];
      }
    }
  }
  const body={orderTypeCode:type,sourceChannelCode:'app',currencyCode:'CNY',items:[item],usePoints:false};
  const box=document.getElementById('t-resp'); box.innerHTML='<div class="loading"><span class="spin"></span>提交中...</div>';
  const r=await api('/api/v1/orders',{method:'POST',body,headers:{'X-User-Id':u}});
  tradeResp(box,r);
  if(r.ok){
    trade.orderId=r.data.orderId;trade.amount=r.data.payableAmount;trade.user=u;
    const it=trade.preset&&trade.preset.item;
    setCtx({userId:u,orderId:trade.orderId,amount:trade.amount,paymentNo:null,paid:false,refundId:null,
      product:it?{name:it.productName,refId:it.productId,type:it.productTypeCode}:CTX.product});
    toast('订单 #'+trade.orderId+' 已创建，已进入支付环节');
    setTimeout(()=>{trade.step=2;renderTrade();setFlow('trade');},600);
  }
}
const REQUIRES_TRAVELER=new Set(['flight_cabin','train_seat','bus_seat']);
async function startPay(){
  const method=document.getElementById('t-paymethod').value, client=document.getElementById('t-client').value;
  const box=document.getElementById('t-resp'); box.innerHTML='<div class="loading"><span class="spin"></span>处理中...</div>';
  const r=await api(`/api/v1/orders/${trade.orderId}/pay`,{method:'POST',body:{paymentMethodCode:method,clientType:client},headers:{'X-User-Id':trade.user}});
  tradeResp(box,r);
  if(r.ok){
    trade.paymentNo=r.data.paymentNo;trade.amount=r.data.amount;trade.payMethod=method;
    setCtx({paymentNo:trade.paymentNo,amount:trade.amount,payMethod:method});
    toast('支付单 '+trade.paymentNo+' 已生成');
    setTimeout(()=>{trade.step=3;renderTrade();setFlow('pay');},600);
  }
}
async function payCallback(){
  const status=document.getElementById('t-cbstatus').value, method=document.getElementById('t-cbmethod').value;
  const body={paymentNo:trade.paymentNo,orderId:trade.orderId,paymentMethodCode:method,amount:trade.amount,statusCode:status,paidAt:status==='success'?'2026-11-19 10:45:00':null};
  const box=document.getElementById('t-resp'); box.innerHTML='<div class="loading"><span class="spin"></span>处理中...</div>';
  const r=await api('/api/v1/payments/callback',{method:'POST',body,headers:{'X-Demo-Payment-Signature':'mock-payment-signature'}});
  tradeResp(box,r);
  if(r.ok){
    setCtx({paid:status==='success',refundId:null});
    toast(status==='success'?'支付成功！订单 #'+trade.orderId+' 可退款，积分已同步':'支付失败，可重新发起');
    setTimeout(()=>{trade.step=4;renderTrade();setFlow('pay');},600);
  }
}
async function getOrder(){
  const box=document.getElementById('t-resp'); box.innerHTML='<div class="loading"><span class="spin"></span>查询中...</div>';
  tradeResp(box,await api(`/api/v1/orders/${trade.orderId}`,{headers:{'X-User-Id':trade.user}}));
}
/* 交易完成 → 带订单进入售后退款，自动填好刚支付的明细 */
async function gotoRefundWithOrder(){
  const u=trade.user||currentUid();
  setCtx({userId:u});
  const r=await api(`/api/v1/orders/${trade.orderId}`,{headers:{'X-User-Id':u}});
  if(!r.ok){alert('查询订单失败：'+JSON.stringify(r.data));return}
  switchPanel('refund');
  document.getElementById('refund-uid').value=u;
  await loadRefundableItems();
  // 优先选中刚支付的可退明细
  const items=r.data.items||[];
  const paid=items.find(it=>['paid','ticketed','completed'].includes(it.statusCode));
  if(paid){
    const opts=[...document.getElementById('refund-picker').options];
    const idx=opts.findIndex(o=>String(o.value)!==''&&REFUNDABLE_ITEMS[+o.value]?.itemId===paid.orderItemId);
    if(idx>=0){
      document.getElementById('refund-picker').selectedIndex=idx;
      syncComboOf('refund-picker');
      pickRefundItem();
    } else {
      // 该明细可能状态未同步，仍直接带入
      document.getElementById('refund-order').value=trade.orderId;
      document.getElementById('refund-item').value=paid.orderItemId;
      document.getElementById('refund-amount').value=Number(paid.saleAmount||0).toFixed(2);
    }
  }
  document.getElementById('refund-create-resp').innerHTML=`<div class="note" style="color:#1a7f37">已从订单 #${trade.orderId} 带入明细，确认金额后即可发起退款。</div>`;
}

