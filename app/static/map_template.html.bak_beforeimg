<script>
const PRESETS={
  '三亚':['亚龙湾','蜈支洲岛','天涯海角','南山文化旅游区','海棠湾','鹿回头','西岛'],
  '云南':['大理古城','洱海','丽江古城','玉龙雪山','石林','滇池','泸沽湖'],
  '厦门':['鼓浪屿','中山路步行街','沙坡尾','曾厝垵','环岛路','南普陀寺'],
  '张家界':['张家界国家森林公园','天门山','武陵源','袁家界','金鞭溪'],
  '成都':['成都大熊猫繁育研究基地','宽窄巷子','武侯祠','锦里','春熙路','都江堰'],
  '杭州':['西湖','灵隐寺','龙井村','河坊街','西溪湿地','雷峰塔']
};
const COORDS={
  '三亚':{'亚龙湾':[18.2149,109.6393],'蜈支洲岛':[18.3077,109.7592],'天涯海角':[18.2470,109.3510],'南山文化旅游区':[18.3010,109.2010],'海棠湾':[18.3000,109.7200],'鹿回头':[18.2200,109.5100],'西岛':[18.2300,109.3700]},
  '云南':{'大理古城':[25.6060,100.1550],'洱海':[25.7500,100.1700],'丽江古城':[26.8720,100.2340],'玉龙雪山':[27.1040,100.1760],'石林':[24.8140,103.3300],'滇池':[25.0400,102.7000],'泸沽湖':[27.7000,100.7700]},
  '厦门':{'鼓浪屿':[24.4470,118.0650],'中山路步行街':[24.4800,118.0890],'沙坡尾':[24.4400,118.0900],'曾厝垵':[24.4300,118.1200],'环岛路':[24.4400,118.1300],'南普陀寺':[24.4400,118.0880]},
  '张家界':{'张家界国家森林公园':[29.3250,110.4500],'天门山':[29.1300,110.4800],'武陵源':[29.3500,110.5500],'袁家界':[29.3400,110.5000],'金鞭溪':[29.3300,110.4800]},
  '成都':{'成都大熊猫繁育研究基地':[30.7400,104.1470],'宽窄巷子':[30.6700,104.0550],'武侯祠':[30.6460,104.0490],'锦里':[30.6460,104.0550],'春熙路':[30.6570,104.0820],'都江堰':[31.0000,103.6200]},
  '杭州':{'西湖':[30.2430,120.1490],'灵隐寺':[30.2400,120.1000],'龙井村':[30.2200,120.1000],'河坊街':[30.2400,120.1700],'西溪湿地':[30.2700,120.0600],'雷峰塔':[30.2310,120.1480]}
};
const DAY_COLORS=['#e11d48','#2563eb','#059669','#d97706','#7c3aed','#0891b2','#db2777'];
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let map=null, markerLayer=null, lineLayer=null, labelLayer=null, infoWin=null;
let autoDrawn=false, pendingAction=null;
let mode='free', currentPlan=null, planPoints=[], planDrawn=false, activeDay=0, lastPlanUid='';

function initMap(){
  if(map)return true;
  if(!window.TMap){$('status').textContent='地图组件加载中…';return false;}
  const box=$('map');
  // 容器宽高为 0（面板 display:none）时不要建图，否则腾讯地图会抛 far <= 0
  if(!box||box.clientWidth<10||box.clientHeight<10)return false;
  try{
    map=new TMap.Map('map',{zoom:11,center:new TMap.LatLng(30.25,120.15)});
    $('status').textContent='';
    return true;
  }catch(e){$('status').textContent='地图初始化失败：'+(e.message||e);return false;}
}
// 建图可能要等容器可见，未就绪时把动作挂起，由 ResizeObserver 补执行
function requestDraw(action){
  if(initMap()){
    try{map.resize();}catch(e){}
    setTimeout(action,60);
  }else pendingAction=action;
}
function parseHash(){
  const h=(location.hash||'').replace(/^#/,'');
  if(!h)return false;
  const p=new URLSearchParams(h);
  const city=p.get('city'), spots=p.get('spots');
  if(city&&$('city').querySelector('option[value="'+city+'"]'))$('city').value=city;
  if(spots)$('spots').value=spots;
  return true;
}
function clearLayers(){
  [markerLayer,lineLayer,labelLayer].forEach(L=>{if(L){try{L.setMap(null);}catch(e){}}});
  markerLayer=lineLayer=labelLayer=null;
}
function setStatus(txt,color){const s=$('status');s.textContent=txt||'';s.style.color=color||'#b45309';}

/* ==================== 模式切换 ==================== */
function setMode(m){
  mode=m;
  $('tab-free').classList.toggle('active',m==='free');
  $('tab-plan').classList.toggle('active',m==='plan');
  $('free-controls').style.display=m==='free'?'':'none';
  $('plan-controls').style.display=m==='plan'?'':'none';
  $('timeline').style.display=m==='plan'&&currentPlan?'':'none';
  if(m==='free'){
    $('legend').innerHTML='<span style="color:#9ca3af">提示：内置 6 城市景点用真实坐标直接打点；自定义景点走腾讯地图实时地理编码。</span>';
    if(!autoDrawn)requestDraw(()=>{autoDrawn=true;draw();});
    else requestDraw(()=>{try{map.resize();}catch(e){}});
  }else{
    if(currentPlan&&!planDrawn)requestDraw(drawPlan);
    else requestDraw(()=>{try{map.resize();}catch(e){}});
  }
}

/* ==================== 自由绘制模式 ==================== */
async function draw(){
  if(!initMap())return;
  const names=$('spots').value.split(/[,，、]/).map(s=>s.trim()).filter(Boolean).slice(0,15);
  if(!names.length){setStatus('请填写至少一个景点');return}
  const city=$('city').value, travel=$('mode').value;
  setStatus('');
  $('status').innerHTML='<span class="spin"></span> 正在定位 '+names.length+' 个景点…';
  const geocoder=new TMap.service.Geocoder();
  const pts=[]; const misses=[]; let builtin=0, geo=0;
  for(const name of names){
    const c=COORDS[city]&&COORDS[city][name];
    if(c){pts.push({name,lat:c[0],lng:c[1]});builtin++;continue;}
    try{
      const r=await geocoder.getLocation({address:city+name});
      const loc=r.result&&r.result.location;
      if(loc){pts.push({name,lat:loc.lat,lng:loc.lng});geo++;}
      else misses.push(name);
    }catch(e){misses.push(name);}
  }
  if(!pts.length){setStatus('未定位到任何景点，试试内置 6 城市景点或更具体的名称');return}
  clearLayers();
  markerLayer=new TMap.MultiMarker({
    map:map,
    styles:{pin:new TMap.MarkerStyle({width:26,height:36,anchor:{x:13,y:36},color:'#e11d48'})},
    geometries:pts.map((p,i)=>({id:'p'+i,styleId:'pin',position:new TMap.LatLng(p.lat,p.lng),properties:{title:p.name}}))
  });
  markerLayer.on('click',evt=>{const g=evt.geometry;if(g&&g.properties)setStatus('📍 '+g.properties.title,'#047857');});
  const svc = travel==='walk' ? new TMap.service.Walking() : new TMap.service.Driving({policy:'LEAST_TIME'});
  let legs=[]; let realRoute=0;
  for(let i=0;i<pts.length-1;i++){
    let seg=[];
    try{
      const r=await svc.getDirection({from:new TMap.LatLng(pts[i].lat,pts[i].lng),to:new TMap.LatLng(pts[i+1].lat,pts[i+1].lng)});
      const route=r.result&&r.result.routes&&r.result.routes[0];
      if(route&&route.polyline&&route.polyline.length)seg=route.polyline;
    }catch(e){}
    if(seg.length){legs=legs.concat(seg);realRoute++;}
    else legs.push({lat:pts[i].lat,lng:pts[i].lng},{lat:pts[i+1].lat,lng:pts[i+1].lng});
  }
  if(legs.length){
    lineLayer=new TMap.MultiPolyline({
      map:map,
      styles:{road:new TMap.PolylineStyle({color:realRoute?'#2563eb':'#7c3aed',width:realRoute?6:3,borderWidth:1,borderColor:realRoute?'#1e40af':'#5b21b6',lineCap:'round',dashArray:realRoute?undefined:[4,4]})},
      geometries:[{id:'route',styleId:'road',paths:legs.map(p=>new TMap.LatLng(p.lat,p.lng))}]
    });
  }
  fitPoints(pts);
  setStatus('已绘制 '+pts.length+' 个景点（内置坐标 '+builtin+(geo?' / 实时定位 '+geo:'')+'）'+
    (realRoute?' · 实时路线':' · 直线连线')+(misses.length?' · 未找到:'+misses.join('/'):''),'#047857');
  const info=$('info');
  info.style.display='block';
  info.innerHTML='<h2 style="margin-top:0">📍 本次线路（按顺序）</h2><div class="spots-list">'+
    pts.map((p,i)=>'<span class="tag">'+(i+1)+'. '+esc(p.name)+'</span>').join('')+'</div>'+
    (misses.length?'<div class="legend">未定位：'+esc(misses.join('、'))+'</div>':'');
}
function fitPoints(pts){
  if(!pts.length)return;
  try{
    const b=new TMap.LatLngBounds();
    pts.forEach(p=>b.extend(new TMap.LatLng(p.lat,p.lng)));
    map.fitBounds(b,{padding:70});
  }catch(e){
    const lats=pts.map(p=>p.lat),lngs=pts.map(p=>p.lng);
    map.setCenter(new TMap.LatLng((Math.min.apply(null,lats)+Math.max.apply(null,lats))/2,(Math.min.apply(null,lngs)+Math.max.apply(null,lngs))/2));
    if(pts.length>1)map.setZoom(12);
  }
}

/* ==================== AI 行程地图模式 ==================== */
// 从行程对象里按天提取打卡点。
// 注意：知识库城市在 AI 面板里用占位 areaId，返回的商品可能来自别的城市，
// 因此这类城市优先用「行程文本里提到的真实景点」（COORDS 有精确坐标），
// 商品只在时间轴里展示，不参与打点，避免把外地点画到地图上。
function extractPlanDays(plan){
  const city=(plan.city||'').replace(/[市省]$/,'');
  const preset=PRESETS[city]||[];
  const coordSet=COORDS[city]||null;
  const days=[];
  (plan.days_plan||[]).forEach((dp,i)=>{
    const text=[dp.title,dp.morning,dp.afternoon,dp.evening].filter(Boolean).join(' ');
    const names=[], fromText=[];
    if(coordSet){
      Object.keys(coordSet).forEach(n=>{if(text.indexOf(n)>=0&&names.indexOf(n)<0){names.push(n);fromText.push(n);}});
    }
    (dp.recommendations||[]).forEach(x=>{
      if(!x||!x.name)return;
      let n=String(x.name).split(/[-－—（(]/)[0].trim();
      if(!n||names.indexOf(n)>=0)return;
      if(coordSet){if(coordSet[n])names.push(n);}   // 知识库城市只收能精确打点的
      else names.push(n);                            // 商品城市：用商品名走地理编码
    });
    // 不足 2 个点时用城市代表景点按天轮转兜底（标记为建议打卡，气泡里不带当天文案以免文不对题）
    for(let k=0;names.length<2&&preset.length;k++){
      const n=preset[(i*2+k)%preset.length];
      if(names.indexOf(n)<0)names.push(n);
    }
    days.push({
      day:dp.day||(i+1), title:dp.title||('第'+(i+1)+'天'),
      morning:dp.morning||'', afternoon:dp.afternoon||'', evening:dp.evening||'',
      recommendations:dp.recommendations||[], names:names.slice(0,4),
      textNames:fromText.slice(0,4),
      color:DAY_COLORS[i%DAY_COLORS.length]
    });
  });
  return days;
}
function buildPlanUI(plan,days){
  const total=days.reduce((s,d)=>s+d.names.length,0);
  const powered=plan.ai_powered;
  $('plan-head').innerHTML=
    '<div class="plan-title">✦ '+esc(plan.city||'')+' '+esc(days.length)+' 日行程'+
      '<span class="badge'+(powered?'':' local')+'">'+(powered?'通义千问生成':'本地推荐')+'</span></div>'+
    '<div class="plan-meta">'+
      '<span>📅 '+days.length+' 天</span><span>📍 '+total+' 个打卡点</span>'+
      '<span>💰 预算 ¥'+Number(plan.budget||0).toFixed(0)+'</span>'+
      '<span>🧾 预估 ¥'+Number(plan.estimated_cost||0).toFixed(0)+'</span>'+
      (plan.hotels&&plan.hotels.length?'<span>🏨 '+plan.hotels.length+' 家酒店</span>':'')+
    '</div>'+
    (plan.summary?'<p class="plan-summary">'+esc(plan.summary)+'</p>':'')+
    (plan.tips?'<p class="plan-tips">💡 '+esc(plan.tips)+'</p>':'')+
    '<div class="filter" id="day-filter">'+
      '<button data-day="0" class="active" style="background:#4f46e5;color:#fff">全部</button>'+
      days.map((d,i)=>'<button data-day="'+(i+1)+'"><span class="dot" style="background:'+d.color+'"></span>第 '+d.day+' 天</button>').join('')+
    '</div>'+
    '<div class="plan-actions"><button id="back-ai">← 回 AI 行程助手调整</button>'+
      '<button id="re-draw">重新绘制</button></div>';
  // 时间轴
  $('timeline').innerHTML=days.map((d,i)=>
    '<div class="day-card" data-day="'+(i+1)+'" style="border-left-color:'+d.color+'">'+
      '<h4><span class="dnum" style="background:'+d.color+'">'+(i+1)+'</span>'+esc(d.title)+'</h4>'+
      (d.morning?'<div class="slot"><b>上午</b><span>'+esc(d.morning)+'</span></div>':'')+
      (d.afternoon?'<div class="slot"><b>下午</b><span>'+esc(d.afternoon)+'</span></div>':'')+
      (d.evening?'<div class="slot"><b>晚上</b><span>'+esc(d.evening)+'</span></div>':'')+
      '<div class="day-spots">'+d.names.map((n,k)=>'<span class="sp">'+(k+1)+'. '+esc(n)+'</span>').join('')+'</div>'+
      ((d.recommendations||[]).length?'<div class="day-rec">🛒 '+d.recommendations.filter(x=>x&&x.name).slice(0,3).map(x=>esc(x.name)+(x.price!=null?' ¥'+Number(x.price).toFixed(0):'')).join(' · ')+'</div>':'')+
    '</div>').join('');
  // 事件
  $('day-filter').querySelectorAll('button').forEach(b=>b.onclick=()=>{
    activeDay=+b.dataset.day;
    $('day-filter').querySelectorAll('button').forEach(x=>{x.classList.remove('active');x.style.background='';x.style.color='';x.style.borderColor='';});
    b.classList.add('active');b.style.background='#4f46e5';b.style.color='#fff';b.style.borderColor='transparent';
    $('timeline').querySelectorAll('.day-card').forEach(c=>c.classList.toggle('active',activeDay&&+c.dataset.day===activeDay));
    renderPlanLayers();
  });
  $('timeline').querySelectorAll('.day-card').forEach(c=>c.onclick=()=>{
    const d=+c.dataset.day;
    const btn=$('day-filter').querySelector('button[data-day="'+d+'"]');if(btn)btn.click();
  });
  $('back-ai').onclick=()=>{try{parent.postMessage({type:'goto-ai'},'*');}catch(e){}};
  $('re-draw').onclick=()=>{planPoints=[];planDrawn=false;requestDraw(drawPlan);};
  $('timeline').style.display='';
  // 图例
  $('legend').innerHTML='<span style="color:#6b7280;font-weight:600">按天着色：</span>'+
    days.map((d,i)=>'<span class="legend-item" data-day="'+(i+1)+'"><span class="bar" style="background:'+d.color+'"></span>第 '+d.day+' 天</span>').join('')+
    (plan.references&&plan.references.length?'<span style="color:#9ca3af;margin-left:6px">📚 参考 '+esc(plan.references.length)+' 篇攻略</span>':'');
  $('legend').querySelectorAll('.legend-item').forEach(x=>x.onclick=()=>{
    const btn=$('day-filter').querySelector('button[data-day="'+x.dataset.day+'"]');if(btn)btn.click();
  });
}
async function drawPlan(){
  if(!initMap()||!currentPlan)return;
  const days=extractPlanDays(currentPlan);
  if(!days.length){setStatus('这份行程没有可绘制的日程');return}
  if(!planPoints.length){
    setStatus('');$('status').innerHTML='<span class="spin"></span> 正在定位行程中的打卡点…';
    const city=(currentPlan.city||'').replace(/[市省]$/,'');
    const geocoder=new TMap.service.Geocoder();
    for(let i=0;i<days.length;i++){
      for(let k=0;k<days[i].names.length;k++){
        const name=days[i].names[k];
        const c=COORDS[city]&&COORDS[city][name];
        let pos=null;
        if(c)pos={lat:c[0],lng:c[1]};
        else{
          try{
            const r=await geocoder.getLocation({address:name,region:city||undefined});
            const loc=r.result&&r.result.location;
            if(loc)pos={lat:loc.lat,lng:loc.lng};
          }catch(e){}
        }
        if(pos)planPoints.push({dayIdx:i,k,name,lat:pos.lat,lng:pos.lng,color:days[i].color,title:days[i].title,day:days[i].day,
          fromText:(days[i].textNames||[]).indexOf(name)>=0});
      }
    }
  }
  if(!planPoints.length){setStatus('未能定位到行程中的景点，试试切换到「自由绘制」用城市代表景点', '#b45309');return}
  renderPlanLayers();
  planDrawn=true;
  setStatus('已按 '+days.length+' 天着色绘制 '+planPoints.length+' 个打卡点 · 点击圆点看详情','#047857');
  $('info').style.display='block';
  $('info').innerHTML='<h2 style="margin-top:0">📋 行程打卡点</h2><div class="spots-list">'+
    planPoints.map((p,i)=>'<span class="tag" style="border-color:'+p.color+'33;color:'+p.color+'">D'+p.day+' · '+esc(p.name)+'</span>').join('')+'</div>'+
    (currentPlan.references&&currentPlan.references.length?'<div class="legend">📚 引用攻略：'+currentPlan.references.map(x=>esc(x)).join('、')+'</div>':'');
}
function renderPlanLayers(){
  if(!initMap())return;
  clearLayers();
  const shown=activeDay?planPoints.filter(p=>p.dayIdx===activeDay-1):planPoints;
  if(!shown.length){setStatus('这一天没有可显示的打卡点');return}
  const byDay={};
  shown.forEach(p=>{(byDay[p.dayIdx]=byDay[p.dayIdx]||[]).push(p);});
  // 每天一种颜色 + 一个 marker style
  const mStyles={};Object.keys(byDay).forEach(k=>{
    mStyles['d'+k]=new TMap.MarkerStyle({width:26,height:36,anchor:{x:13,y:36},color:DAY_COLORS[k%DAY_COLORS.length]});
  });
  const geoms=shown.map(p=>({id:'m'+p.dayIdx+'_'+p.k,styleId:'d'+p.dayIdx,
    position:new TMap.LatLng(p.lat,p.lng),properties:{p}}));
  markerLayer=new TMap.MultiMarker({map:map,styles:mStyles,geometries:geoms});
  // 序号标签（部分环境不支持则静默跳过）
  try{
    labelLayer=new TMap.MultiLabel({map:map,
      styles:{n:new TMap.LabelStyle({color:'#111827',size:11,offset:{x:0,y:-30}})},
      geometries:shown.map((p,i)=>({id:'l'+p.dayIdx+'_'+p.k,styleId:'n',position:new TMap.LatLng(p.lat,p.lng),content:String(i+1)}))});
  }catch(e){labelLayer=null;}
  // 每天一条折线
  const lStyles={},lGeoms=[];
  Object.keys(byDay).forEach(k=>{
    const arr=byDay[k];
    lStyles['d'+k]=new TMap.PolylineStyle({color:DAY_COLORS[k%DAY_COLORS.length],width:5,borderWidth:1,borderColor:'#ffffff',lineCap:'round'});
    if(arr.length>1)lGeoms.push({id:'line'+k,styleId:'d'+k,paths:arr.map(p=>new TMap.LatLng(p.lat,p.lng))});
  });
  if(lGeoms.length)lineLayer=new TMap.MultiPolyline({map:map,styles:lStyles,geometries:lGeoms});
  // 详情气泡
  try{
    if(!infoWin)infoWin=new TMap.InfoWindow({map:map,position:new TMap.LatLng(shown[0].lat,shown[0].lng),content:'',offset:{x:0,y:-34}});
    infoWin.close();
    markerLayer.on('click',evt=>{
      const g=evt.geometry,p=g&&g.properties&&g.properties.p;if(!p)return;
      const d=extractPlanDays(currentPlan)[p.dayIdx]||{};
      const recs=(d.recommendations||[]).filter(x=>x&&x.name);
      let slot='', hint='';
      if(p.fromText){
        slot=p.k===0?(d.morning||d.afternoon||''):(p.k===1?(d.afternoon||d.evening||''):(d.evening||''));
      }else{
        hint='<div class="iw-s" style="color:#9ca3af">建议打卡点（当天行程未点名具体景点）</div>';
      }
      const html='<div class="iw"><div class="iw-t">'+esc(p.name)+'</div>'+
        '<div class="iw-d">第 '+p.day+' 天 · '+esc(p.title)+'</div>'+
        (slot?'<div class="iw-s">'+esc(slot)+'</div>':hint)+
        (p.fromText&&recs.length?'<div class="iw-p">🛒 '+recs.slice(0,2).map(x=>esc(x.name)+(x.price!=null?' ¥'+Number(x.price).toFixed(0):'')).join(' · ')+'</div>':'')+'</div>';
      try{infoWin.setContent(html);infoWin.setPosition(g.position);infoWin.open();}
      catch(e){setStatus('📍 第'+p.day+'天 · '+p.name+(slot?' — '+slot:''),'#047857');}
    });
  }catch(e){infoWin=null;}
  fitPoints(shown);
}
function receivePlan(plan){
  if(!plan||!plan.days_plan)return;
  const uid=plan._uid||JSON.stringify([plan.city,plan.days,plan.summary,plan.estimated_cost]);
  if(uid===lastPlanUid&&mode==='plan')return;   // 同一份行程不重复地理编码
  lastPlanUid=uid;
  currentPlan=plan;planPoints=[];planDrawn=false;activeDay=0;
  const days=extractPlanDays(plan);
  buildPlanUI(plan,days);
  setMode('plan');
}

/* ==================== 事件绑定 ==================== */
$('tab-free').onclick=()=>setMode('free');
$('tab-plan').onclick=()=>setMode('plan');
$('draw').onclick=()=>{autoDrawn=true;initMap();draw();};
$('preset').onclick=()=>{$('spots').value=(PRESETS[$('city').value]||[]).join(',');setMode('free');autoDrawn=false;requestDraw(()=>{autoDrawn=true;draw();});};
$('city').onchange=()=>{$('spots').value=(PRESETS[$('city').value]||[]).join(',');autoDrawn=false;requestDraw(()=>{autoDrawn=true;draw();});};
$('go-ai').onclick=()=>{try{parent.postMessage({type:'goto-ai'},'*');}catch(e){}};
// 首次加载：读 hash 参数，容器可见后自动画自由线路
window.addEventListener('load',()=>{
  parseHash();
  requestDraw(()=>{if(!autoDrawn){autoDrawn=true;draw();}});
  try{parent.postMessage({type:'map-ready'},'*');}catch(e){}
});
// 容器尺寸从 0 变为可见时（面板 display:none→block）自动补建图
if(window.ResizeObserver){
  try{new ResizeObserver(()=>{
    if(!map){
      if(initMap()&&pendingAction){const a=pendingAction;pendingAction=null;try{map.resize();}catch(e){}setTimeout(a,60);}
    }else{try{map.resize();}catch(e){}}
  }).observe($('map'));}catch(e){}
}
// 接收父页面消息
window.addEventListener('message',e=>{
  const d=e.data||{};
  if(d.type==='ai-plan'){receivePlan(d.plan);}
  else if(d.type==='map-show'){
    if(map){try{map.resize();}catch(e){}}
    if(mode==='plan'&&currentPlan&&!planDrawn)requestDraw(drawPlan);
    else if(mode==='free'&&!autoDrawn)requestDraw(()=>{autoDrawn=true;draw();});
  }
});
