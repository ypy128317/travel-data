  .modebar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:10px 14px}
  .tabs{display:inline-flex;background:#f1f3f9;border:1px solid #e6e9f2;border-radius:10px;padding:3px;gap:2px}
