  select:hover,input:hover{border-color:#c3cae0}
  select:focus,input:focus{border-color:#4f46e5;box-shadow:0 0 0 3px rgba(79,70,229,.14)}
  input#spots{min-width:380px}
  button.btn{border:0;border-radius:9px;padding:9px 16px;font-size:12.8px;cursor:pointer;font-weight:600;transition:.18s;font-family:inherit}
  .btn-main{background:linear-gradient(135deg,#5b52ea,#4f46e5);color:#fff;box-shadow:0 8px 18px -8px rgba(79,70,229,.9)}
  .btn-main:hover{transform:translateY(-1px);filter:brightness(1.06)}
  .btn-ghost{background:#eef0ff;color:#4f46e5;border:1px solid #e0e3ff}
  .btn-ghost:hover{background:#e3e6ff}
  .tag{display:inline-block;padding:4px 11px;background:#f4f6fb;color:#4f46e5;border:1px solid #e0e3ff;border-radius:999px;font-size:11.5px;margin:3px;font-weight:500}
  .status{color:#b45309;font-size:12.3px;margin-left:auto}
  .legend{font-size:11.8px;color:#6b7280;margin-top:10px;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
  .spots-list{margin-top:10px;display:flex;flex-wrap:wrap;gap:4px}
  #info h2{font-size:15px;margin:0 0 10px;font-weight:700}
  .spin{display:inline-block;width:14px;height:14px;border:2px solid #e0e3ff;border-top-color:#4f46e5;border-radius:50%;animation:sp .8s linear infinite;vertical-align:-2px}
  @keyframes sp{to{transform:rotate(360deg)}}

  /* ===== 行程模式 ===== */
  .plan-head{display:flex;flex-direction:column;gap:9px}
  .plan-title{font-size:16px;font-weight:700;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .plan-title .badge{font-size:11px;font-weight:600;padding:3px 10px;border-radius:999px;background:#eef0ff;color:#4f46e5;border:1px solid #e0e3ff}
  .plan-title .badge.local{background:#fff7ed;color:#b45309;border-color:#fed7aa}
  .plan-meta{display:flex;flex-wrap:wrap;gap:8px}
  .plan-meta span{font-size:12px;color:#374151;background:#f4f6fb;border:1px solid #e6e9f2;border-radius:8px;padding:5px 11px;font-weight:600}
  .plan-summary{margin:0;font-size:13px;color:#4b5563;line-height:1.6}
  .plan-tips{margin:0;font-size:12.3px;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:8px 11px}
  .filter{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
  .filter button{border:1px solid #e0e3ff;background:#fff;color:#4f46e5;border-radius:999px;padding:5px 13px;font-size:11.8px;
    font-weight:600;cursor:pointer;font-family:inherit;transition:.18s;display:flex;align-items:center;gap:6px}
  .filter button:hover{background:#f4f6fb}
  .filter button.active{color:#fff;border-color:transparent}
  .filter .dot{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none}
  .plan-actions{display:flex;gap:8px;margin-top:2px}
  .plan-actions button{border:0;background:#eef0ff;color:#4f46e5;border-radius:8px;padding:7px 13px;font-size:12px;
    font-weight:600;cursor:pointer;font-family:inherit;transition:.18s}
  .plan-actions button:hover{background:#e3e6ff}
  .stage{display:flex;gap:12px;align-items:stretch}
  #map{flex:1;min-width:0;height:520px;border-radius:11px;background:#eef2f7;border:1px solid #e6e9f2;overflow:hidden}
  #timeline{width:290px;flex:none;max-height:520px;overflow-y:auto;padding-right:4px}
  #timeline::-webkit-scrollbar{width:6px}
  #timeline::-webkit-scrollbar-thumb{background:#d7dceb;border-radius:6px}
  .day-card{background:#fff;border:1px solid #e6e9f2;border-radius:11px;padding:12px;margin-bottom:10px;cursor:pointer;
